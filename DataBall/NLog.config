<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${specialfolder:folder=ApplicationData}\\NLog\\internal.log">

    <targets>
        <target xsi:type="File" name="file" fileName="${specialfolder:folder=ApplicationData}\\DataBall\\logs\\databall.log"
                layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message}"
                archiveFileName="${specialfolder:folder=ApplicationData}\\DataBall\\logs\\archives\\databall.{#}.log"
                archiveEvery="Day"
                archiveNumbering="Rolling"
                maxArchiveFiles="7"
                concurrentWrites="true"
                keepFileOpen="false"
                encoding="utf-8" />
    </targets>

    <rules>
        <logger name="*" minlevel="Trace" writeTo="file" />
    </rules>
</nlog>