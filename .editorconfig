root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all

[*.{md,sh,py,yml,yaml}]
indent_style = space
indent_size = 2

[*.{csproj,props,targets,yml,yaml,json,xml}]
indent_style = space
indent_size = 2
